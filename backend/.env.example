# 사진 분석(Vision) 설정 — 이 파일을 참고해 셸에서 export 하거나, 사용하는 도구의 env 기능에 넣으세요.
# 실제 키가 들어간 파일은 절대 커밋/공유하지 마세요. (.env 는 .gitignore 에 포함됨)

# --- 기본: NVIDIA build.nvidia.com 무료 호스팅 API ---
# 키 발급: https://build.nvidia.com → 로그인 → Settings → API Keys (nvapi- 로 시작)
NVIDIA_API_KEY=nvapi-여기에_키

# 이미지 입력을 지원하는 모델 ID. 404 가 나면 build.nvidia.com 모델 페이지에서 확인해 바꾸세요.
# VISION_MODEL=meta/llama-3.2-11b-vision-instruct

# --- OpenAI 를 쓰려면 아래 3줄로 바꾸세요 ---
# VISION_API_KEY=sk-...
# VISION_BASE_URL=https://api.openai.com/v1
# VISION_MODEL=gpt-4o

# 서버가 분당 허용할 분석 횟수 (무료 API 한도 약 40회/분보다 낮게)
# VISION_RPM=30

# --- 논문 기반 추천(RAG) ---
# 근거 요약에 쓸 텍스트 모델 (기본: openai/gpt-oss-20b, 2026-10 기준 동작 확인). 404/410 이 나면 모델이 종료된 것이니
# https://integrate.api.nvidia.com/v1/models 목록에서 확인해 바꾸세요. (meta/llama-3.1-70b-instruct 는 2026-08-26 종료)
# COACH_MODEL=openai/gpt-oss-20b
# 추천 요청 한도(분당), 질의 단어가 논문에 포함돼야 하는 최소 비율(0~1, 높일수록 엄격)
# COACH_RPM=10
# COACH_MIN_COVERAGE=0.6
# 질의별 1위 점수 대비 이 비율보다 낮은 논문은 제외 (0~1, 기본 0.4, 0=끔). python eval_retrieval.py --min-rel 0.5 로 먼저 시험하세요.
# COACH_MIN_REL=0.4
# 논문 DB 파일 위치 (기본: backend/papers.db)
# BROCOMPASS_PAPERS_DB=

# (선택) 임베딩 검색. 설정하면 키워드 검색 결과의 순서를 의미 유사도로 다듬습니다.
# 모델 ID 는 build.nvidia.com 에서 임베딩 모델을 확인해 넣으세요. 바꾸면 ingest_pubmed.py --embed 를 다시 실행해야 합니다.
# EMBED_MODEL=

# (선택) PubMed 수집: 키가 있으면 속도 제한이 완화됩니다. https://account.ncbi.nlm.nih.gov/settings/
# NCBI_API_KEY=
# NCBI_EMAIL=you@example.com

# --- 공개 배포용 보호 설정 (로컬 개발에서는 설정하지 않아도 됩니다) ---
# 공개 배포에서는 반드시 켜세요. 노트 API 가 X-Client-Id(브라우저가 만든 무작위 ID) 없는 요청을 거절하고 사용자별로 분리합니다.
# REQUIRE_CLIENT_ID=1
# 신뢰하는 프록시(Render 등)가 X-Forwarded-For 를 붙여 주는 환경에서만 켭니다. 켜지 않으면 접속자 IP 를 직접 연결 상대로 봅니다.
# 켜는 경우 실제 접속자 IP 가 제대로 구분되는지 배포 후 확인하세요(구분이 안 되면 모든 방문자가 한 IP 로 계산됩니다).
# TRUST_PROXY=1
# 브라우저가 서버를 직접 호출하는 구조일 때 허용할 주소(쉼표 구분). /api 프록시(rewrite) 구조면 필요 없습니다.
# CORS_ORIGINS=https://내-프론트.vercel.app
# IP 별 분당 한도 (0 이면 끔)와 하루 AI 호출 총량(UTC 기준, 0 이면 끔)
# IP_VISION_RPM=6
# IP_COACH_RPM=4
# IP_NOTES_RPM=120
# AI_DAILY_CAP=300

# AI 서버 응답을 기다리는 최대 시간(초). 코치 AI 요약이 "시간이 초과" 로 실패하면 늘려 보세요. (기본 90)
# AI_TIMEOUT_S=90
# 모델이 안 될 때: python diagnose_models.py 로 내 키에서 되는 모델을 찾아 VISION_MODEL / COACH_MODEL 에 넣으세요.
# 추론(reasoning) 모델을 쓸 때: 생각에 토큰을 먼저 쓰므로 출력 한도를 넉넉히 늘립니다.
# VISION_MAX_TOKENS=2500
# COACH_MAX_TOKENS=3000
# 추론 모델의 '생각' 단계를 끄는 옵션. 켜면 응답이 훨씬 빨라지는 모델이 있습니다
# (nvidia/nemotron-3.5-super-vl-120b-a12b 는 python diagnose_models.py --nothink 로 확인함). 지원하지 않는 모델은 오류가 날 수 있으니 시험 후 켜세요.
# VISION_NO_THINK=1
# COACH_NO_THINK=1
